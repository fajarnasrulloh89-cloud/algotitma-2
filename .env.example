PORT=3000

# Login default aplikasi
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!

# SMTP untuk kirim email OTP secara real time.
# Contoh Gmail: gunakan App Password, bukan password akun biasa.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Manajemen Mahasiswa <your_email@gmail.com>"
